# Configuração do Supabase (copie este arquivo para .env e preencha)
# Supabase > Project Settings > API Keys
# Use SOMENTE a URL e a chave PUBLICA (publishable ou anon).
# NUNCA coloque a chave service_role no aplicativo.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA_AQUI

# Endereco de retorno dos e-mails (recuperacao de senha / confirmacao).
# Cadastre o mesmo valor em Authentication > URL Configuration > Redirect URLs.
AUTH_REDIRECT_URL=br.senai.safecore://login-callback
